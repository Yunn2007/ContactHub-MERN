{
  "name": "contacthub-mern",
  "version": "1.0.0",
  "description": "Contact Hub - Full-Stack MERN Application",
  "private": true,
  "scripts": {
    "dev": "(cd backend && npm run dev) & (cd frontend && npm run dev)",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && npm start",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "mern",
    "react",
    "express",
    "mongodb",
    "nodejs",
    "contact-management"
  ],
  "author": "Yunus Khan",
  "license": "ISC"
}

