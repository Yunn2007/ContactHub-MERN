# ==============================================================================
# CONTACT HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env inside the backend folder and fill in your actual values:
# cp .env.example .env
#
# DO NOT commit your actual .env file with real credentials to version control.
# ==============================================================================

# Server Port (default: 5001)
PORT=5001

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/contacthub?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/contacthub?retryWrites=true&w=majority

# JSON Web Token Secret Key for signing and verifying authentication tokens
# Example: a-strong-random-secret-string-at-least-32-chars
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Credentials for image storage (contact photos and user avatars)
# Obtain these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

